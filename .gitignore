# ==========================================
# Node.js зависимости и логи
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Секреты и настройки окружения (ВАЖНО!)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Загруженные пользователями файлы (фото поломок)
# ==========================================
# Игнорируем все файлы в папке uploads...
public/uploads/*
# ...но оставляем саму папку в Git (чтобы она не удалялась при клонировании)
!public/uploads/.gitkeep

# ==========================================
# Системные файлы ОС
# ==========================================
.DS_Store          # macOS
Thumbs.db          # Windows
Desktop.ini        # Windows

# ==========================================
# Настройки редакторов кода
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Временные файлы и сборки
# ==========================================
dist/
build/
*.log